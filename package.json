    "security:privileged": "node scripts/privileged-access-audit.js",
    "lint:hygiene": "node scripts/source-hygiene.js"
  },
  "devDependencies": {
    "wrangler": "4.141.0"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
