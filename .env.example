# Telegram
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
TELEGRAM_PUBLISHER_BOT_TOKEN=PASTE_TELEGRAM_PUBLISHER_BOT_TOKEN
TELEGRAM_CHANNEL_ID=@MatchRadarFootball
TELEGRAM_WEBHOOK_SECRET=PASTE_RANDOM_WEBHOOK_SECRET
ADMIN_TELEGRAM_IDS=123456789
BETA_TELEGRAM_IDS=
BETA_ACCESS_ENABLED=false

# Data providers
API_FOOTBALL_KEY=PASTE_API_FOOTBALL_KEY
# Optional relay base URL for API-Football (own network egress; see supabase/functions/football-relay). Empty = direct provider.
API_FOOTBALL_BASE_URL=
FOOTBALL_DATA_TOKEN=
THE_ODDS_API_KEY=
TAVILY_KEY=PASTE_TAVILY_KEY

# Runtime
DEV_MODE=false
FREE_DAILY_LIMIT=3
PRO_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=100
CACHE_MINUTES=20
ENABLE_LIVE_ODDS=true
MONETIZATION_ENABLED=false
OPS_RETENTION_DAYS=14
GROWTH_RETENTION_DAYS=90

# Telegram Stars / access passes
PRO_STARS_PRICE=199
PREMIUM_STARS_PRICE=399
MATCH_PASS_STARS_PRICE=39
DAY_PASS_STARS_PRICE=89
WEEKEND_PASS_STARS_PRICE=149
MATCH_PASS_DURATION_HOURS=72
DAY_PASS_DURATION_HOURS=24
WEEKEND_PASS_DURATION_HOURS=168
WEEKEND_PASS_USAGE_LIMIT=6

# Supabase
SUPABASE_URL=
# Preferred server-side key. Never expose this value to the browser/client bundle.
SUPABASE_SECRET_KEY=
# Legacy fallback kept for existing deployments; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# AI-объяснение матча (Cloudflare Workers AI через биндинг AI в wrangler.jsonc — без ключей).
# AI только выбирает и упорядочивает факты; тексты и цифры собирает сервер.
AI_EXPLANATION_ENABLED=true
# Потолок вызовов модели: на весь сервис — в сутки (UTC), на одного пользователя — в час.
AI_EXPLANATION_DAILY_LIMIT=1000
AI_EXPLANATION_USER_HOURLY_LIMIT=6
# Задача 6: «Спросить про матч» (ответ — только факты из каталога; готовые подсказки без LLM).
MATCH_QUESTIONS_ENABLED=true
# Сервис: вопросов к Workers AI в сутки; пользователь: свободных вопросов в час.
MATCH_QUESTIONS_DAILY_LIMIT=500
MATCH_QUESTIONS_USER_HOURLY_LIMIT=10

# Предматчевые вероятности для главных матчей дня (фоновое задание cron).
# Сколько матчей за запуск, потолок в сутки, интервал между запусками (мин.)
# и минимальный остаток запросов API-Football на FREE, ниже которого задание ждёт.
PREMATCH_PREDICTIONS_ENABLED=true
# Исполнитель фоновых задач: github — только GitHub Actions (cron Cloudflare игнорируется), cloudflare — cron воркера.
BACKGROUND_JOBS_EXECUTOR=github
# Ставит только scripts/cron-runner.js (github-actions); в Cloudflare не задавать.
CRON_RUNNER=
# Cron Cloudflare каждые 5 минут просит GitHub запустить .github/workflows/cron-runner.yml.
# Секрет Cloudflare: fine-grained токен GitHub, только этот репозиторий, «Actions: Read and write».
# Без токена cron Cloudflare ничего не делает, задачи идут только по расписанию GitHub.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPOSITORY=TRAP44/football-analytics-cloudflare
PREMATCH_PREDICTIONS_PER_RUN=3
PREMATCH_PREDICTIONS_DAILY_LIMIT=60
PREMATCH_PREDICTIONS_INTERVAL_MINUTES=30
PREMATCH_PREDICTIONS_FREE_RESERVE=60
