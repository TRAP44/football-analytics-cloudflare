TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
# Separate bot token used only for manual channel publishing.
TELEGRAM_PUBLISHER_BOT_TOKEN=PASTE_TELEGRAM_PUBLISHER_BOT_TOKEN
TELEGRAM_CHANNEL_ID=@MatchRadarFootball
TELEGRAM_WEBHOOK_SECRET=PASTE_RANDOM_WEBHOOK_SECRET
ADMIN_TELEGRAM_IDS=123456789
# Optional strict closed-beta allowlist. Used only when BETA_ACCESS_ENABLED=true.
BETA_TELEGRAM_IDS=
# Public mode is the safe project default: any user with valid Telegram initData gets normal-user access.
# Set true only for a temporary strict closed beta. Missing is treated exactly like false.
BETA_ACCESS_ENABLED=false
API_FOOTBALL_KEY=PASTE_API_FOOTBALL_KEY
# Optional standings fallback. Leave empty until a football-data.org token is added.
FOOTBALL_DATA_TOKEN=
# Optional licensed 1X2 odds fallback. Server-side only; leave empty until you add your own The Odds API key.
THE_ODDS_API_KEY=
TAVILY_KEY=PASTE_TAVILY_KEY

DEV_MODE=false

FREE_DAILY_LIMIT=3
PRO_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=100

CACHE_MINUTES=20
ENABLE_LIVE_ODDS=true
MONETIZATION_ENABLED=false
OPS_RETENTION_DAYS=14
GROWTH_RETENTION_DAYS=90

PRO_STARS_PRICE=199
PREMIUM_STARS_PRICE=399

# One-time Telegram Stars Pass pricing. Monetization stays disabled until MONETIZATION_ENABLED=true.
MATCH_PASS_STARS_PRICE=39
DAY_PASS_STARS_PRICE=89
WEEKEND_PASS_STARS_PRICE=149
MATCH_PASS_DURATION_HOURS=72
DAY_PASS_DURATION_HOURS=24
WEEKEND_PASS_DURATION_HOURS=72

SUPABASE_URL=
# Prefer the current opaque Supabase secret key. The legacy service-role key is
# still accepted by the Worker for existing installations.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
