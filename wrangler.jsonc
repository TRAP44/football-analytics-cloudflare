{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "football-analytics-cloudflare",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*",
      "/telegram/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "DEV_MODE": "false",
    "TELEGRAM_CHANNEL_ID": "@MatchRadarFootball",
    "FREE_DAILY_LIMIT": "3",
    "PRO_DAILY_LIMIT": "20",
    "PREMIUM_DAILY_LIMIT": "100",
    "CACHE_MINUTES": "20",
    "GROWTH_RETENTION_DAYS": "90",
    "WEEKEND_PASS_USAGE_LIMIT": "6",
    "MONETIZATION_ENABLED": "true"
  }
}
