// Production handoff marker: 2026-10-07 public release
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "football-analytics-cloudflare",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*",
      "/telegram/*",
      "/.env*",
      "/.git/*",
      "/wp-*",
      "/phpmyadmin*",
      "/vendor/phpunit/*",
      "/actuator*",
      "/server-status*",
      "/cgi-bin/*"
    ]
  },
  // Фоновые задачи выполняет GitHub Actions (.github/workflows/cron-runner.yml):
  // на Workers Free cron-запуск ограничен 10 мс CPU. Cron здесь — только часы:
  // каждые 5 минут воркер просит GitHub запустить workflow (GITHUB_DISPATCH_TOKEN),
  // потому что расписание самого GitHub срабатывает раз в несколько часов.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DEV_MODE": "false",
    "TELEGRAM_CHANNEL_ID": "@MatchRadarFootball",
    "FREE_DAILY_LIMIT": "3",
    "PRO_DAILY_LIMIT": "20",
    "PREMIUM_DAILY_LIMIT": "100",
    "CACHE_MINUTES": "20",
    "GROWTH_RETENTION_DAYS": "90",
    "WEEKEND_PASS_DURATION_HOURS": "168",
    "WEEKEND_PASS_USAGE_LIMIT": "6",
    "MONETIZATION_ENABLED": "true",
    "API_FOOTBALL_BASE_URL": "https://nlmvhkjkpgzzlfavaohk.supabase.co/functions/v1/football-relay",
    "AI_EXPLANATION_ENABLED": "true",
    "AI_EXPLANATION_DAILY_LIMIT": "1000",
    "AI_EXPLANATION_USER_HOURLY_LIMIT": "6",
    "PREMATCH_PREDICTIONS_ENABLED": "true",
    "BACKGROUND_JOBS_EXECUTOR": "github",
    "GITHUB_DISPATCH_REPOSITORY": "TRAP44/football-analytics-cloudflare",
    "PREMATCH_PREDICTIONS_PER_RUN": "2",
    "PREMATCH_PREDICTIONS_DAILY_LIMIT": "20",
    "PREMATCH_PREDICTIONS_INTERVAL_MINUTES": "30",
    "PREMATCH_PREDICTIONS_FREE_RESERVE": "60"
  },
  "ratelimits": [
    {
      "name": "EDGE_ANALYZE_RATE_LIMIT",
      "namespace_id": "386101",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "EDGE_SENSITIVE_RATE_LIMIT",
      "namespace_id": "386102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "EDGE_WEBHOOK_RATE_LIMIT",
      "namespace_id": "386103",
      "simple": {
        "limit": 6000,
        "period": 60
      }
    }
  ]
}
